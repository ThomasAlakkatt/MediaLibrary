# Copy this file to backend/.env and fill in your own values. Never commit backend/.env.

# Discogs personal access token: discogs.com > Settings > Developers > Generate new token
DISCOGS_API_KEY=

# Any name that identifies the app to Discogs. Not a secret.
DISCOGS_USER_AGENT=MediaLibrary/1.0

# TMDB "API Read Access Token" (the long one, not the shorter API Key): themoviedb.org > Settings > API
TMDB_API_READ_ACCESS_TOKEN=

# Optional: where to keep the library. Defaults to backend/medialibrary.db.
# MEDIALIBRARY_DB=/path/to/medialibrary.db
